# Configuration for Portainer deployment with latest image tags
# Use these version tags - they are verified to exist in the registry
ANY_SYNC_NODE_VERSION=latest
ANY_SYNC_FILENODE_VERSION=latest
ANY_SYNC_COORDINATOR_VERSION=latest
ANY_SYNC_CONSENSUSNODE_VERSION=latest

CONFIG_DIR="/data/anytype/config"
STORAGE_DIR="/data/anytype/storage"

ANY_SYNC_DOMAIN=anytype.yourdomain.com

# Put your server's public IP address here, so that the clients can connect to the server using this address.
# You can specify multiple addresses separated by space, and the server will listen on all of them
# EXTERNAL_LISTEN_HOST="133.133.133.133 127.0.0.1"
